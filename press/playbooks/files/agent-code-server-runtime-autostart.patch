--- a/agent/bench.py
+++ b/agent/bench.py
@@ -742,6 +742,7 @@ class Bench(Base):
     @job("Setup Code Server")
     def setup_code_server(self, name, password):
         self.create_code_server_config(name)
+        self.ensure_code_server_runtime()
         self._start_code_server(password, setup=True)
